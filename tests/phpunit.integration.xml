<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    backupGlobals="false"
    colors="true"
    processIsolation="true"
    stopOnFailure="false"
    failOnWarning="true"
    failOnDeprecation="true"
    failOnPhpunitDeprecation="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <php>
        <!-- Rendering a forum page compiles the frontend assets of every enabled extension. -->
        <ini name="memory_limit" value="1G"/>
    </php>
    <testsuites>
        <testsuite name="Integration Tests">
            <directory suffix="Test.php">./integration</directory>
        </testsuite>
    </testsuites>
    <!--
        Only deprecations raised by this extension's own code count. Those raised
        inside vendor/ are not ours to fix: middlewares/utils 3.x declares implicit
        nullable parameters (deprecated in PHP 8.4), and core's franzl/whoops-middleware
        pins it to ^3.0, so the 4.x that fixes it cannot be installed.
    -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>../src</directory>
        </include>
    </source>
</phpunit>
