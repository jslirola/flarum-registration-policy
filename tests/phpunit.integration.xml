<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    backupGlobals="false"
    colors="true"
    processIsolation="true"
    stopOnFailure="false"
>
    <php>
        <ini name="memory_limit" value="1G"/>
    </php>
    <testsuites>
        <testsuite name="Integration Tests">
            <directory suffix="Test.php">./integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
